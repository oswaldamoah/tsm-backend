# Copy to .env for local development. On Render, set these as environment variables.

# --- Database ---
# Leave unset to use the local SQLite file (telecom_sites.db).
# DATABASE_URL=postgresql://user:password@host/dbname

# --- Auth ---
# Signs login sessions. Set a long random value in production
# (python -c "import secrets; print(secrets.token_urlsafe(48))").
# If unset, one is generated and stored in the database.
# SECRET_KEY=change-me

# Sign-up is only possible with an access phrase you hand out.
# Leave both unset to turn self sign-up off entirely.
SIGNUP_ACCESS_CODE=          # people who sign up with this become managers
ADMIN_SIGNUP_ACCESS_CODE=    # people who sign up with this become admins

# --- Password reset emails (Resend) ---
# API key from https://resend.com/api-keys. Without it, reset links are
# printed to the server log instead of emailed (handy locally).
RESEND_API_KEY=
# Must be on a domain you verified in Resend. onboarding@resend.dev works
# without a domain but only delivers to your own Resend account email.
RESEND_FROM_EMAIL=Telecom Site Manager <onboarding@resend.dev>
# Where the reset link in the email points (your deployed frontend).
FRONTEND_URL=http://localhost:5173

# --- AI assistant ---
# Provider: gemini (default) | groq | openrouter | ollama
AI_PROVIDER=gemini

# Free Gemini key from https://aistudio.google.com/apikey (no card required).
GEMINI_API_KEY=

# Groq is the most generous free tier by a wide margin (~14k requests/day vs
# Gemini's ~20). Set this key and the assistant will automatically use Groq to
# cover Gemini rate limits - or set AI_PROVIDER=groq to lead with it.
# GROQ_API_KEY=

# OPENROUTER_API_KEY=

# Optional: override the model. Defaults per provider:
#   gemini     -> gemini-3.6-flash
#   groq       -> openai/gpt-oss-120b
#   openrouter -> meta-llama/llama-3.3-70b-instruct:free
#   ollama     -> llama3.1
# AI_MODEL=gemini-3.6-flash

# Models to fall back to when the primary is rate limited, in order. Free tiers
# meter per model, so these are separate quota buckets on the same key.
# Defaults to gemini-3.5-flash,gemini-3.1-flash-lite when the provider is gemini.
# AI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.1-flash-lite

# Set to 1 to stop the chain from failing over to a different provider entirely.
# AI_DISABLE_PROVIDER_FAILOVER=

# Seconds to wait on a single model call (default 60)
# AI_REQUEST_TIMEOUT=60

# Wall-clock seconds for one whole question (default 90). Must stay below the
# gunicorn --timeout in the Procfile.
# AI_TOTAL_BUDGET=90
